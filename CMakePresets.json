{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 30, "patch": 0},
  "configurePresets": [
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "asan", "inherits": "debug", "binaryDir": "${sourceDir}/build/asan", "cacheVariables": {"HFT_SANITIZERS": "ON"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug", "jobs": 4},
    {"name": "release", "configurePreset": "release", "jobs": 4},
    {"name": "asan", "configurePreset": "asan", "jobs": 4}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}
  ]
}
