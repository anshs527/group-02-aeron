# Driver environment reference; the smoke script assigns its own unique path.
# Replace this path with a NEW directory for each manual run.
AERON_DIR=/absolute/path/to/private/run/aeron
AERON_THREADING_MODE=SHARED
AERON_DIR_DELETE_ON_START=false
AERON_DIR_DELETE_ON_SHUTDOWN=false
AERON_IPC_TERM_BUFFER_LENGTH=65536
# Client flags (not environment variables):
# --request-stream 1001 --response-stream 1002 --messages 1000 --warmup 100
# --startup-timeout-ms 10000 --response-timeout-ms 2000
